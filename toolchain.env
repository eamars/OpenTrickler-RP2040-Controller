# The versions this repository builds with, written once (ADR-011). Read by setup_toolchain.ps1,
# configure_env.ps1, setup_toolchain.sh, configure_env.sh, tools/remote_control/rc_run.py and CI.
# One NAME=value a line, no quotes and no spaces; a line that starts with # is a note.

# Arm GNU toolchain (arm-none-eabi), as Arm names the release
ARM_GCC=15.2.rel1

CMAKE=4.3.4
NINJA=1.13.2

# raspberrypi/pico-sdk-tools: the release that pioasm and picotool come from, and their version in it
PICO_SDK_TOOLS_RELEASE=v2.3.1-0
PICO_TOOLS=2.3.1

# OpenOCD, which flashes and reads the bench's unit through the probe, and the tools release it comes from.
# Left at the build ADR-001 proved while the firmware's own dependencies move (ADR-011).
OPENOCD=0.12.0+dev
OPENOCD_RELEASE=v2.1.1-3
